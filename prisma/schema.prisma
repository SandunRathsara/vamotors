  deductions                 Json
  fee                        BigInt
  feeMode                    String
  net                        BigInt
  separatelyRecoverableCharges BigInt
  reason                     String
  state                      String           @default("REQUESTED")
  revision                   Int              @default(1)
  createdBy                  String           @db.Uuid
  commandId                  String           @unique @db.Uuid
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  payments                   FacilityPayment[]

  @@schema("vamotors")
}

model FacilityPayment {
  id           String       @id @default(uuid()) @db.Uuid
  facilityId   String       @db.Uuid
  facility     CashFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  amount       BigInt
  direction    String
  component    String
  occurredDate DateTime     @db.Date
  method       String
  reference    String?
  reversalOf   String?      @unique @db.Uuid
  reason       String?
  createdBy    String       @db.Uuid
  commandId    String       @db.Uuid
  lineKey      String
  recordedAt   DateTime     @default(now())

  @@unique([commandId, lineKey])
  @@unique([id, facilityId])
  @@index([facilityId, occurredDate, id])
  @@schema("vamotors")
}

model BrokerageFeeReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  dealId       String        @db.Uuid
  deal         BrokerageDeal @relation(fields: [dealId], references: [id], onDelete: Restrict)
  category     String
  amount       BigInt
  direction    String
  occurredDate DateTime      @db.Date
  method       String
  reference    String?
  reversalOf   String?       @unique @db.Uuid
  reason       String?
  createdBy    String        @db.Uuid
  commandId    String        @db.Uuid
  lineKey      String
  recordedAt   DateTime      @default(now())

  @@unique([commandId, lineKey])
  @@index([dealId, occurredDate, id])
  @@schema("vamotors")
}

model DispatchBatch {
  id            String         @id @default(uuid()) @db.Uuid
  handedOverAt  DateTime
  courier       String
  tracking      String?
  createdBy     String         @db.Uuid
  createdAt     DateTime       @default(now())
  commandId     String         @unique @db.Uuid
  revision      Int            @default(1)
  items         DispatchItem[]

  @@schema("vamotors")
}

model DispatchItem {
  id              String         @id @default(uuid()) @db.Uuid
  batchId         String         @db.Uuid
  batch           DispatchBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceType      String         @default("BROKERAGE")
  brokerageDealId String?        @unique @db.Uuid
  brokerageDeal   BrokerageDeal? @relation(fields: [brokerageDealId], references: [id], onDelete: Restrict)
  saleCaseId      String?        @unique @db.Uuid
  sourceRevision  Int
  checklistHash   String
  sentAt          DateTime

  @@schema("vamotors")
}

model CommissionEntitlement {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @db.Uuid
  sourceType      String         @default("BROKERAGE")
  brokerageDealId String?        @unique @db.Uuid
  brokerageDeal   BrokerageDeal? @relation(fields: [brokerageDealId], references: [id], onDelete: Restrict)
  saleCaseId      String?        @unique @db.Uuid
  expectedAmount  BigInt
  policySnapshot  Json
  eligibleAt      DateTime
  sentDate        DateTime       @db.Date
  sentDateSource  String
  state           String         @default("OPEN")
  revision        Int            @default(1)
  createdBy       String         @db.Uuid
  commandId       String         @unique @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, state, sentDate, id])
  @@schema("vamotors")
}

model ImportedFile {
  sha256 String @id
  attachmentId String @unique @db.Uuid
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  batchId String @db.Uuid
  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rows ImportSourceRow[]

  @@schema("vamotors")
}

model ImportSourceRow {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fileHash String
  file ImportedFile @relation(fields: [fileHash], references: [sha256], onDelete: Restrict)
  namespace String
  sourceType String
  sourceKey String
  rowNumber Int
  aliases String[] @default([])
  metadata Json?
  targetVersionId String @unique @db.Uuid
  targetVersion EntityReadVersion @relation(fields: [targetVersionId], references: [id], onDelete: Restrict)

  @@unique([namespace, sourceType, sourceKey])
  @@index([batchId])
  @@schema("vamotors")
}

model ImportCommandAnchor {
  id Int @id

  @@schema("vamotors")
}
