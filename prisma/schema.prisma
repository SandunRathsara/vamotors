generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["vamotors"]
}

// Auth fields generated by auth@1.6.23; retained actors use RESTRICT, not cascade.
model User {
  id               String            @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  active           Boolean           @default(true)
  authzRevision    Int               @default(1)
  sessions         Session[]
  accounts         Account[]
  roles            UserRole[]        @relation("member")
  assignments      UserRole[]        @relation("assigner")
  notifications    Notification[]
  approvalRequests ApprovalRequest[] @relation("approvalRequester")
  approvalReviews  ApprovalRequest[] @relation("approvalReviewer")
  disposals        Disposal[]

  @@map("user")
  @@schema("vamotors")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
  @@schema("vamotors")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("vamotors")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("vamotors")
}

model Environment {
  singleton           Int       @id @default(1)
  id                  String    @unique @db.Uuid
  name                String
  allowBusinessWrites Boolean   @default(false)
  disposableTest      Boolean   @default(false)
  bootstrappedAt      DateTime?
  bootstrapTokenHash  String?
  bootstrapExpiresAt  DateTime?

  @@schema("vamotors")
}

model AdminGuard {
  id         Int    @id @default(1)
  generation BigInt @default(0)

  @@schema("vamotors")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  systemKey   String?          @unique
  active      Boolean          @default(true)
  revision    Int              @default(1)
  memberships UserRole[]
  permissions RolePermission[]

  @@schema("vamotors")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  ruleHash String           @unique
  rule     Json
  roles    RolePermission[]

  @@schema("vamotors")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@schema("vamotors")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation("member", fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   User     @relation("assigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@schema("vamotors")
}

model BusinessSequence {
  id    Int    @id @default(1)
  value BigInt @default(0)

  @@schema("vamotors")
}

model CommandReceipt {
  id                    String              @id @db.Uuid
  environmentId         String              @db.Uuid
  actorKey              String
  commandName           String
  idempotencyKey        String              @db.Uuid
  inputHash             String
  committedAt           DateTime            @default(now())
  responseSchemaVersion Int                 @default(1)
  result                Json
  businessSequence      BigInt?             @unique
  audit                 AuditEntry[]
  versions              EntityReadVersion[]
  statuses              StatusEvent[]
  acquisitions          PurchaseRecord[]
  purchasePayments      PurchasePayment[]
  mileageReadings       MileageReading[]
  basisVersions         CycleBasisVersion[]
  costs                 VehicleCost[]
  costPayments          CostPayment[]
  repairs               RepairRecord[]      @relation("repairDispatch")
  repairReturns         RepairRecord[]      @relation("repairReturn")
  repairPayments        RepairPayment[]
  approvalRequests      ApprovalRequest[]   @relation("approvalRequestCommand")
  approvalReviews       ApprovalRequest[]   @relation("approvalReviewCommand")
  approvalApplications  ApprovalRequest[]   @relation("approvalAppliedCommand")
  disposals             Disposal[]
  disposalReceipts      DisposalReceipt[]

  @@unique([environmentId, actorKey, commandName, idempotencyKey])
  @@schema("vamotors")
}

model EntityReadVersion {
  id         String         @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String         @db.Uuid
  sequence   BigInt
  revision   Int
  payload    Json
  tombstone  Boolean        @default(false)
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, sequence])
  @@index([entityType, entityId, sequence(sort: Desc)])
  @@index([sequence])
  @@schema("vamotors")
}

model AuditEntry {
  id          String         @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String         @db.Uuid
  commandId   String         @db.Uuid
  command     CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  action      String
  actorKind   String
  userId      String?        @db.Uuid
  systemScope String?
  initiatedBy String?        @db.Uuid
  approverId  String?        @db.Uuid
  reason      String?
  recordedAt  DateTime       @default(now())
  fieldDiff   Json

  @@index([entityType, entityId, recordedAt, id])
  @@index([userId, recordedAt, id])
  @@index([commandId])
  @@schema("vamotors")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  eventKey        String
  kind            String
  targetType      String
  targetId        String    @db.Uuid
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  revision        Int       @default(1)

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, readAt, createdAt, id])
  @@schema("vamotors")
}

model Customer {
  id                 String           @id @default(uuid()) @db.Uuid
  fullName           String
  callingName        String
  nicOrPassport      String
  normalizedIdentity String           @unique
  address            String
  phone              String
  email              String?
  drivingLicence     String?
  notes              String?
  active             Boolean          @default(true)
  revision           Int              @default(1)
  createdBy          String           @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  purchases          PurchaseRecord[]

  @@index([phone])
  @@schema("vamotors")
}

model SettingsVersion {
  id          String           @id @default(uuid()) @db.Uuid
  version     Int              @unique
  effectiveAt DateTime         @default(now())
  values      Json
  current     Settings?
  purchases   PurchaseRecord[]

  @@schema("vamotors")
}

model Settings {
  id               String          @id @default(uuid()) @db.Uuid
  singleton        Int             @unique @default(1)
  revision         Int             @default(1)
  currentVersionId String          @unique @db.Uuid
  currentVersion   SettingsVersion @relation(fields: [currentVersionId], references: [id], onDelete: Restrict)

  @@schema("vamotors")
}

model FinanceCompany {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  active              Boolean                @default(true)
  revision            Int                    @default(1)
  createdBy           String                 @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  currentPolicyId     String                 @unique @db.Uuid
  currentPolicy       FinancePolicyVersion   @relation("currentPolicy", fields: [currentPolicyId, id], references: [id, companyId], onDelete: Restrict)
  policies            FinancePolicyVersion[] @relation("policies")
  contacts            FinanceContact[]
  rateSheets          RateSheetVersion[]
  quotes              Quote[]
  settlementPurchases LeasePurchaseDetail[]

  @@unique([currentPolicyId, id])
  @@schema("vamotors")
}

model RateSheetVersion {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  company      FinanceCompany  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  version      Int
  revision     Int             @default(1)
  make         String
  model        String
  year         Int
  maximum      BigInt
  validFrom    DateTime        @db.Date
  validThrough DateTime        @db.Date
  publishedAt  DateTime        @default(now())
  createdBy    String          @db.Uuid
  commandId    String          @unique @db.Uuid
  cards        RateCardEntry[]
  quotes       Quote[]

  @@unique([companyId, make, model, year, version])
  @@index([companyId, make, model, year, validFrom])
  @@schema("vamotors")
}

model RateCardEntry {
  id             String           @id @default(uuid()) @db.Uuid
  sheetVersionId String           @db.Uuid
  sheet          RateSheetVersion @relation(fields: [sheetVersionId], references: [id], onDelete: Restrict)
  principal      BigInt
  months         Int
  installment    BigInt
  quotes         Quote[]

  @@unique([sheetVersionId, principal, months])
  @@unique([id, sheetVersionId])
  @@schema("vamotors")
}

model Quote {
  id                 String           @id @default(uuid()) @db.Uuid
  revision           Int              @default(1)
  sheetId            String           @db.Uuid
  sheet              RateSheetVersion @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  cardId             String           @db.Uuid
  card               RateCardEntry    @relation(fields: [cardId, sheetId], references: [id, sheetVersionId], onDelete: Restrict)
  companyId          String           @db.Uuid
  company            FinanceCompany   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle            Json
  principal          BigInt
  months             Int
  installment        BigInt
  maximum            BigInt
  charges            Json
  policyVersionId    String           @db.Uuid
  policySnapshot     Json
  companySnapshot    Json
  settingsVersionId  String           @db.Uuid
  settingsSnapshot   Json
  commissionExpected BigInt
  createdBy          String           @db.Uuid
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  commandId          String           @unique @db.Uuid

  @@index([createdBy, createdAt, id])
  @@schema("vamotors")
}

model FinancePolicyVersion {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  company     FinanceCompany  @relation("policies", fields: [companyId], references: [id], onDelete: Restrict)
  version     Int
  effectiveAt DateTime        @default(now())
  values      Json
  currentFor  FinanceCompany? @relation("currentPolicy")

  @@unique([id, companyId])
  @@unique([companyId, version])
  @@schema("vamotors")
}

model FinanceContact {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  company   FinanceCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  phone     String
  email     String?
  role      String
  isPrimary Boolean        @default(false)
  active    Boolean        @default(true)

  @@schema("vamotors")
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  category       String
  nicOrRegNumber String?
  address        String?
  phone          String?
  hotline        String?
  notes          String?
  recurring      Boolean           @default(false)
  active         Boolean           @default(true)
  revision       Int               @default(1)
  createdBy      String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contacts       SupplierContact[]
  purchases      PurchaseRecord[]

  @@schema("vamotors")
}

model SupplierContact {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  phone      String
  email      String?
  role       String
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)

  @@schema("vamotors")
}

model RepairVendor {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  category       String
  nicOrRegNumber String?
  address        String?
  phone          String?
  hotline        String?
  notes          String?
  recurring      Boolean         @default(false)
  specialisation String?
  active         Boolean         @default(true)
  revision       Int             @default(1)
  createdBy      String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contacts       VendorContact[]
  repairs        RepairRecord[]

  @@schema("vamotors")
}

model VendorContact {
  id        String       @id @default(uuid()) @db.Uuid
  vendorId  String       @db.Uuid
  vendor    RepairVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  name      String
  phone     String
  email     String?
  role      String
  isPrimary Boolean      @default(false)
  active    Boolean      @default(true)

  @@schema("vamotors")
}

enum VehicleStatus {
  PURCHASED
  IN_STOCK
  IN_REPAIR
  ADVANCE_PLACED
  ADVANCE_EXPIRED
  FINANCE_PENDING
  DO_RECEIVED
  DELIVERED
  SOLD
  WRITTEN_OFF

  @@schema("vamotors")
}

model Vehicle {
  id                String           @id @default(uuid()) @db.Uuid
  engineNumber      String
  chassisNumber     String
  normalizedEngine  String
  normalizedChassis String
  make              String
  model             String
  year              Int
  colour            String
  fuelType          String
  transmission      String
  vin               String?
  crNumber          String?
  notes             String?
  revision          Int              @default(1)
  createdBy         String           @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  activePurchaseId  String?          @unique @db.Uuid
  purchases         PurchaseRecord[] @relation("cycles")
  activePurchase    PurchaseRecord?  @relation("activeCycle", fields: [activePurchaseId, id], references: [id, vehicleId], onDelete: Restrict)
  mileage           MileageReading[]

  @@unique([normalizedEngine, normalizedChassis])
  @@unique([activePurchaseId, id])
  @@schema("vamotors")
}

model PurchaseRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  vehicleId            String               @db.Uuid
  vehicle              Vehicle              @relation("cycles", fields: [vehicleId], references: [id], onDelete: Restrict)
  activeFor            Vehicle?             @relation("activeCycle")
  cycleNumber          Int
  purchaseType         String
  acquisitionKind      String
  supplierId           String?              @db.Uuid
  supplier             Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sellerCustomerId     String?              @db.Uuid
  seller               Customer?            @relation(fields: [sellerCustomerId], references: [id], onDelete: Restrict)
  purchaseDate         DateTime             @db.Date
  purchasePrice        BigInt
  notes                String?
  listedPrice          BigInt?
  status               VehicleStatus        @default(PURCHASED)
  available            Boolean              @default(false)
  holdReason           String?
  receivedDate         DateTime?            @db.Date
  closedAt             DateTime?
  revision             Int                  @default(1)
  createdBy            String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  statuses             StatusEvent[]
  acquisitionCommandId String?              @unique @db.Uuid
  acquisitionCommand   CommandReceipt?      @relation(fields: [acquisitionCommandId], references: [id], onDelete: Restrict)
  settingsVersionId    String?              @db.Uuid
  settingsVersion      SettingsVersion?     @relation(fields: [settingsVersionId], references: [id], onDelete: Restrict)
  payments             PurchasePayment[]
  mileage              MileageReading[]
  basisVersions        CycleBasisVersion[]
  costs                VehicleCost[]
  costPayments         CostPayment[]
  repairs              RepairRecord[]
  repairPayments       RepairPayment[]
  approvalRequests     ApprovalRequest[]
  disposal             Disposal?
  settlement           LeasePurchaseDetail?

  @@unique([id, vehicleId])
  @@unique([vehicleId, cycleNumber])
  @@index([status, available, purchaseDate, id])
  @@schema("vamotors")
}

// Mutable current terms only; root revisions and immutable read versions own history.
model LeasePurchaseDetail {
  id                      String          @id @default(uuid()) @db.Uuid
  purchaseRecordId        String          @unique @db.Uuid
  purchaseRecord          PurchaseRecord  @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  institutionType         String
  companyId               String?         @db.Uuid
  company                 FinanceCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  institutionNameSnapshot String
  reference               String
  amount                  BigInt
  cashToSeller            BigInt

  @@schema("vamotors")
}

model StatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  cycleId    String         @db.Uuid
  cycle      PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  from       VehicleStatus?
  to         VehicleStatus
  action     String
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  userId     String         @db.Uuid
  occurredAt DateTime
  recordedAt DateTime       @default(now())

  @@index([cycleId, recordedAt, id])
  @@schema("vamotors")
}

model PurchasePayment {
  id           String           @id @default(uuid()) @db.Uuid
  cycleId      String           @db.Uuid
  cycle        PurchaseRecord   @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime         @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  reversalOf   String?          @unique @db.Uuid
  original     PurchasePayment? @relation("purchaseReversal", fields: [reversalOf, cycleId], references: [id, cycleId], onDelete: Restrict)
  reversal     PurchasePayment? @relation("purchaseReversal")
  reason       String?
  commandId    String           @db.Uuid
  command      CommandReceipt   @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime         @default(now())

  @@unique([id, cycleId])
  @@unique([commandId, lineKey])
  @@unique([reversalOf, cycleId])
  @@index([cycleId, occurredDate, id])
  @@schema("vamotors")
}

model ApprovalRequest {
  id                   String          @id @db.Uuid
  cycleId              String          @db.Uuid
  cycle                PurchaseRecord  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  kind                 String
  schemaVersion        Int             @default(1)
  proposal             Json
  expected             Json
  snapshot             Json
  payloadHash          String
  reason               String
  requestedBy          String          @db.Uuid
  requester            User            @relation("approvalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  requestedAt          DateTime        @default(now())
  state                String          @default("PENDING")
  revision             Int             @default(1)
  reviewedBy           String?         @db.Uuid
  reviewer             User?           @relation("approvalReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  reviewNote           String?
  reviewerName         String?
  requiredRecipientIds Json
  requestCommandId     String          @unique @db.Uuid
  requestCommand       CommandReceipt  @relation("approvalRequestCommand", fields: [requestCommandId], references: [id], onDelete: Restrict)
  reviewCommandId      String?         @unique @db.Uuid
  reviewCommand        CommandReceipt? @relation("approvalReviewCommand", fields: [reviewCommandId], references: [id], onDelete: Restrict)
  appliedCommandId     String?         @unique @db.Uuid
  appliedCommand       CommandReceipt? @relation("approvalAppliedCommand", fields: [appliedCommandId], references: [id], onDelete: Restrict)
  disposal             Disposal?

  @@unique([id, cycleId])
  @@index([state, requestedAt, id])
  @@index([requestedBy, requestedAt, id])
  @@schema("vamotors")
}

model Disposal {
  id             String            @id @db.Uuid
  cycleId        String            @unique @db.Uuid
  cycle          PurchaseRecord    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  approvalId     String            @unique @db.Uuid
  approval       ApprovalRequest   @relation(fields: [approvalId, cycleId], references: [id, cycleId], onDelete: Restrict)
  approvalKind   String            @default("CURRENT")
  occurredDate   DateTime          @db.Date
  reason         String
  method         String
  proceeds       BigInt
  basisVersionId String            @db.Uuid
  basis          CycleBasisVersion @relation(fields: [basisVersionId, cycleId], references: [id, cycleId], onDelete: Restrict)
  netLoss        BigInt
  createdBy      String            @db.Uuid
  creator        User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  commandId      String            @unique @db.Uuid
  command        CommandReceipt    @relation(fields: [commandId], references: [id], onDelete: Restrict)
  recordedAt     DateTime          @default(now())
  payments       DisposalReceipt[]

  @@unique([id, cycleId])
  @@unique([approvalId, cycleId])
  @@schema("vamotors")
}

model DisposalReceipt {
  id           String         @id @db.Uuid
  disposalId   String         @unique @db.Uuid
  cycleId      String         @db.Uuid
  disposal     Disposal       @relation(fields: [disposalId, cycleId], references: [id, cycleId], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime       @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  commandId    String         @db.Uuid
  command      CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime       @default(now())

  @@unique([commandId, lineKey])
  @@index([cycleId, occurredDate, id])
  @@schema("vamotors")
}

model VehicleCost {
  id           String         @id @default(uuid()) @db.Uuid
  cycleId      String         @db.Uuid
  cycle        PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  category     String
  description  String
  amount       BigInt
  incurredDate DateTime       @db.Date
  revision     Int            @default(1)
  createdBy    String         @db.Uuid
  commandId    String         @db.Uuid
  command      CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  payments     CostPayment[]

  @@unique([id, cycleId])
  @@index([cycleId, incurredDate, id])
  @@schema("vamotors")
}

model CostPayment {
  id           String         @id @default(uuid()) @db.Uuid
  costId       String         @db.Uuid
  cycleId      String         @db.Uuid
  cost         VehicleCost    @relation(fields: [costId, cycleId], references: [id, cycleId], onDelete: Restrict)
  cycle        PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime       @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  reversalOf   String?        @unique @db.Uuid
  original     CostPayment?   @relation("costReversal", fields: [reversalOf, costId, cycleId], references: [id, costId, cycleId], onDelete: Restrict)
  reversal     CostPayment?   @relation("costReversal")
  reason       String?
  createdBy    String         @db.Uuid
  commandId    String         @db.Uuid
  command      CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime       @default(now())

  @@unique([id, costId, cycleId])
  @@unique([commandId, lineKey])
  @@unique([reversalOf, costId, cycleId])
  @@index([costId, occurredDate, id])
  @@schema("vamotors")
}

model RepairRecord {
  id              String          @id @default(uuid()) @db.Uuid
  cycleId         String          @db.Uuid
  cycle           PurchaseRecord  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  vendorId        String          @db.Uuid
  vendor          RepairVendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  request         String
  sentDate        DateTime        @db.Date
  returnedDate    DateTime?       @db.Date
  summary         String?
  invoiceAmount   BigInt?
  invoiceDate     DateTime?       @db.Date
  revision        Int             @default(1)
  createdBy       String          @db.Uuid
  commandId       String          @unique @db.Uuid
  command         CommandReceipt  @relation("repairDispatch", fields: [commandId], references: [id], onDelete: Restrict)
  returnCommandId String?         @unique @db.Uuid
  returnCommand   CommandReceipt? @relation("repairReturn", fields: [returnCommandId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  payments        RepairPayment[]

  @@unique([id, cycleId])
  @@index([cycleId, sentDate, id])
  @@index([vendorId, returnedDate, sentDate, id])
  @@schema("vamotors")
}

model RepairPayment {
  id           String         @id @default(uuid()) @db.Uuid
  repairId     String         @db.Uuid
  cycleId      String         @db.Uuid
  repair       RepairRecord   @relation(fields: [repairId, cycleId], references: [id, cycleId], onDelete: Restrict)
  cycle        PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime       @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  reversalOf   String?        @unique @db.Uuid
  original     RepairPayment? @relation("repairReversal", fields: [reversalOf, repairId, cycleId], references: [id, repairId, cycleId], onDelete: Restrict)
  reversal     RepairPayment? @relation("repairReversal")
  reason       String?
  createdBy    String         @db.Uuid
  commandId    String         @db.Uuid
  command      CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime       @default(now())

  @@unique([id, repairId, cycleId])
  @@unique([commandId, lineKey])
  @@unique([reversalOf, repairId, cycleId])
  @@index([repairId, occurredDate, id])
  @@schema("vamotors")
}

model MileageReading {
  id             String         @id @default(uuid()) @db.Uuid
  vehicleId      String         @db.Uuid
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  cycleId        String         @db.Uuid
  cycle          PurchaseRecord @relation(fields: [cycleId, vehicleId], references: [id, vehicleId], onDelete: Restrict)
  reading        Int
  recordedDate   DateTime       @db.Date
  remark         String?
  decreaseReason String?
  commandId      String         @db.Uuid
  command        CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  recordedAt     DateTime       @default(now())

  @@unique([commandId, cycleId])
  @@index([cycleId, recordedDate, id])
  @@schema("vamotors")
}

model CycleBasisVersion {
  id           String             @id @default(uuid()) @db.Uuid
  cycleId      String             @db.Uuid
  cycle        PurchaseRecord     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  disposals    Disposal[]
  version      Int
  purchase     BigInt
  components   Json
  total        BigInt
  currency     String
  scale        Int
  reason       String
  commandId    String             @db.Uuid
  command      CommandReceipt     @relation(fields: [commandId], references: [id], onDelete: Restrict)
  supersedesId String?            @unique @db.Uuid
  original     CycleBasisVersion? @relation("basisCorrection", fields: [supersedesId, cycleId], references: [id, cycleId], onDelete: Restrict)
  correction   CycleBasisVersion? @relation("basisCorrection")
  recordedAt   DateTime           @default(now())

  @@unique([id, cycleId])
  @@unique([cycleId, version])
  @@unique([supersedesId, cycleId])
  @@schema("vamotors")
}

// Staging metadata only. No preview, imported provenance or business graph exists yet.
model ImportBatch {
  id            String         @id @default(uuid()) @db.Uuid
  environmentId String         @db.Uuid
  createdBy     String         @db.Uuid
  createdAt     DateTime       @default(now())
  revision      Int            @default(1)
  schemaVersion Int            @default(1)
  state         String         @default("STAGED")
  types         String[]
  namespace     String
  commandId     String         @unique @db.Uuid
  uploads       UploadIntent[]
  attachments   Attachment[]

  @@index([createdBy, createdAt, id])
  @@schema("vamotors")
}

model UploadIntent {
  id                     String          @id @default(uuid()) @db.Uuid
  batchId                String          @db.Uuid
  batch                  ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  environmentId          String          @db.Uuid
  createdBy              String          @db.Uuid
  createdAt              DateTime        @default(now())
  purpose                String
  filename               String
  contentType            String
  size                   Int
  sha256                 String
  stagingKey             String          @unique
  capturedTargetRevision Int
  expiresAt              DateTime
  revision               Int             @default(1)
  state                  String          @default("INIT")
  initCommandId          String          @unique @db.Uuid
  currentAttemptId       String?         @unique @db.Uuid
  claimExpiresAt         DateTime?
  currentAttempt         UploadAttempt?  @relation("currentAttempt", fields: [currentAttemptId], references: [id], onDelete: Restrict)
  attempts               UploadAttempt[] @relation("attempts")
  attachment             Attachment?
  events                 UploadEvent[]

  @@index([batchId, id])
  @@schema("vamotors")
}

// Immutable server claim, including exact original request identity and expected bytes.
// The declaration is not a validation proof: restart recovery must readFinal + validate.
model UploadAttempt {
  id             String        @id @db.Uuid
  environmentId  String        @db.Uuid
  uploadId       String        @db.Uuid
  upload         UploadIntent  @relation("attempts", fields: [uploadId], references: [id], onDelete: Restrict)
  currentFor     UploadIntent? @relation("currentAttempt")
  createdBy      String        @db.Uuid
  claimedAt      DateTime
  claimExpiresAt DateTime
  commandId      String        @unique @db.Uuid
  idempotencyKey String        @db.Uuid
  inputHash      String
  uploadRevision Int
  targetRevision Int
  finalKey       String        @unique
  size           Int
  sha256         String
  contentType    String
  attachment     Attachment?

  @@unique([environmentId, createdBy, idempotencyKey])
  @@schema("vamotors")
}

model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  batchId        String        @db.Uuid
  batch          ImportBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  uploadIntentId String        @unique @db.Uuid
  upload         UploadIntent  @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)
  attemptId      String        @unique @db.Uuid
  attempt        UploadAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  environmentId  String        @db.Uuid
  createdBy      String        @db.Uuid
  purpose        String
  filename       String
  contentType    String
  size           Int
  sha256         String
  finalKey       String        @unique
  verifiedAt     DateTime
  commandId      String        @unique @db.Uuid

  @@schema("vamotors")
}

// Append-only protocol history, including interrupted/failed attempts. No capabilities.
model UploadEvent {
  id         String       @id @default(uuid()) @db.Uuid
  uploadId   String       @db.Uuid
  upload     UploadIntent @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  revision   Int
  state      String
  attemptId  String?      @db.Uuid
  recordedAt DateTime     @default(now())
  errorCode  String?
  commandId  String       @db.Uuid

  @@unique([uploadId, revision])
  @@schema("vamotors")
}
