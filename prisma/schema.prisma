generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["vamotors"]
}

// Auth fields generated by auth@1.6.23; retained actors use RESTRICT, not cascade.
model User {
  id            String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  active        Boolean        @default(true)
  authzRevision Int            @default(1)
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]     @relation("member")
  assignments   UserRole[]     @relation("assigner")
  notifications Notification[]

  @@map("user")
  @@schema("vamotors")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
  @@schema("vamotors")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("vamotors")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("vamotors")
}

model Environment {
  singleton           Int       @id @default(1)
  id                  String    @unique @db.Uuid
  name                String
  allowBusinessWrites Boolean   @default(false)
  disposableTest      Boolean   @default(false)
  bootstrappedAt      DateTime?
  bootstrapTokenHash  String?
  bootstrapExpiresAt  DateTime?

  @@schema("vamotors")
}

model AdminGuard {
  id         Int    @id @default(1)
  generation BigInt @default(0)

  @@schema("vamotors")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  systemKey   String?          @unique
  active      Boolean          @default(true)
  revision    Int              @default(1)
  memberships UserRole[]
  permissions RolePermission[]

  @@schema("vamotors")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  ruleHash String           @unique
  rule     Json
  roles    RolePermission[]

  @@schema("vamotors")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@schema("vamotors")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation("member", fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   User     @relation("assigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@schema("vamotors")
}

model BusinessSequence {
  id    Int    @id @default(1)
  value BigInt @default(0)

  @@schema("vamotors")
}

model CommandReceipt {
  id                    String              @id @db.Uuid
  environmentId         String              @db.Uuid
  actorKey              String
  commandName           String
  idempotencyKey        String              @db.Uuid
  inputHash             String
  committedAt           DateTime            @default(now())
  responseSchemaVersion Int                 @default(1)
  result                Json
  businessSequence      BigInt?             @unique
  audit                 AuditEntry[]
  versions              EntityReadVersion[]
  statuses              StatusEvent[]

  @@unique([environmentId, actorKey, commandName, idempotencyKey])
  @@schema("vamotors")
}

model EntityReadVersion {
  id         String         @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String         @db.Uuid
  sequence   BigInt
  revision   Int
  payload    Json
  tombstone  Boolean        @default(false)
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, sequence])
  @@index([entityType, entityId, sequence(sort: Desc)])
  @@index([sequence])
  @@schema("vamotors")
}

model AuditEntry {
  id          String         @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String         @db.Uuid
  commandId   String         @db.Uuid
  command     CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  action      String
  actorKind   String
  userId      String?        @db.Uuid
  systemScope String?
  initiatedBy String?        @db.Uuid
  approverId  String?        @db.Uuid
  reason      String?
  recordedAt  DateTime       @default(now())
  fieldDiff   Json

  @@index([entityType, entityId, recordedAt, id])
  @@index([userId, recordedAt, id])
  @@index([commandId])
  @@schema("vamotors")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  eventKey        String
  kind            String
  targetType      String
  targetId        String    @db.Uuid
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  revision        Int       @default(1)

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, readAt, createdAt, id])
  @@schema("vamotors")
}

model Customer {
  id                 String           @id @default(uuid()) @db.Uuid
  fullName           String
  callingName        String
  nicOrPassport      String
  normalizedIdentity String           @unique
  address            String
  phone              String
  email              String?
  drivingLicence     String?
  notes              String?
  active             Boolean          @default(true)
  revision           Int              @default(1)
  createdBy          String           @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  purchases          PurchaseRecord[]

  @@index([phone])
  @@schema("vamotors")
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  category       String
  nicOrRegNumber String?
  address        String?
  phone          String?
  hotline        String?
  notes          String?
  recurring      Boolean           @default(false)
  active         Boolean           @default(true)
  revision       Int               @default(1)
  createdBy      String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contacts       SupplierContact[]
  purchases      PurchaseRecord[]

  @@schema("vamotors")
}

model SupplierContact {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  phone      String
  email      String?
  role       String
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)

  @@schema("vamotors")
}

enum VehicleStatus {
  PURCHASED
  IN_STOCK
  IN_REPAIR
  ADVANCE_PLACED
  ADVANCE_EXPIRED
  FINANCE_PENDING
  DO_RECEIVED
  DELIVERED
  SOLD
  WRITTEN_OFF

  @@schema("vamotors")
}

model Vehicle {
  id                String           @id @default(uuid()) @db.Uuid
  engineNumber      String
  chassisNumber     String
  normalizedEngine  String
  normalizedChassis String
  make              String
  model             String
  year              Int
  colour            String
  fuelType          String
  transmission      String
  vin               String?
  crNumber          String?
  notes             String?
  revision          Int              @default(1)
  createdBy         String           @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  activePurchaseId  String?          @unique @db.Uuid
  purchases         PurchaseRecord[] @relation("cycles")
  activePurchase    PurchaseRecord?  @relation("activeCycle", fields: [activePurchaseId, id], references: [id, vehicleId], onDelete: Restrict)

  @@unique([normalizedEngine, normalizedChassis])
  @@unique([activePurchaseId, id])
  @@schema("vamotors")
}

model PurchaseRecord {
  id               String        @id @default(uuid()) @db.Uuid
  vehicleId        String        @db.Uuid
  vehicle          Vehicle       @relation("cycles", fields: [vehicleId], references: [id], onDelete: Restrict)
  activeFor        Vehicle?      @relation("activeCycle")
  cycleNumber      Int
  purchaseType     String
  acquisitionKind  String
  supplierId       String?       @db.Uuid
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sellerCustomerId String?       @db.Uuid
  seller           Customer?     @relation(fields: [sellerCustomerId], references: [id], onDelete: Restrict)
  purchaseDate     DateTime      @db.Date
  purchasePrice    BigInt
  listedPrice      BigInt?
  status           VehicleStatus @default(PURCHASED)
  available        Boolean       @default(false)
  holdReason       String?
  receivedDate     DateTime?     @db.Date
  closedAt         DateTime?
  revision         Int           @default(1)
  createdBy        String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  statuses         StatusEvent[]

  @@unique([id, vehicleId])
  @@unique([vehicleId, cycleNumber])
  @@index([status, available, purchaseDate, id])
  @@schema("vamotors")
}

model StatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  cycleId    String         @db.Uuid
  cycle      PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  from       VehicleStatus?
  to         VehicleStatus
  action     String
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  userId     String         @db.Uuid
  occurredAt DateTime
  recordedAt DateTime       @default(now())

  @@index([cycleId, recordedAt, id])
  @@schema("vamotors")
}
