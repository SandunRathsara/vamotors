generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["vamotors"]
}

// Auth fields generated by auth@1.6.23; retained actors use RESTRICT, not cascade.
model User {
  id               String            @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  active           Boolean           @default(true)
  authzRevision    Int               @default(1)
  sessions         Session[]
  accounts         Account[]
  roles            UserRole[]        @relation("member")
  assignments      UserRole[]        @relation("assigner")
  notifications    Notification[]
  approvalRequests ApprovalRequest[] @relation("approvalRequester")
  approvalReviews  ApprovalRequest[] @relation("approvalReviewer")
  disposals        Disposal[]

  @@map("user")
  @@schema("vamotors")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
  @@schema("vamotors")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("vamotors")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("vamotors")
}

model Environment {
  singleton           Int       @id @default(1)
  id                  String    @unique @db.Uuid
  name                String
  allowBusinessWrites Boolean   @default(false)
  disposableTest      Boolean   @default(false)
  bootstrappedAt      DateTime?
  bootstrapTokenHash  String?
  bootstrapExpiresAt  DateTime?

  @@schema("vamotors")
}

model AdminGuard {
  id         Int    @id @default(1)
  generation BigInt @default(0)

  @@schema("vamotors")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  systemKey   String?          @unique
  active      Boolean          @default(true)
  revision    Int              @default(1)
  memberships UserRole[]
  permissions RolePermission[]

  @@schema("vamotors")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  ruleHash String           @unique
  rule     Json
  roles    RolePermission[]

  @@schema("vamotors")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@schema("vamotors")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation("member", fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   User     @relation("assigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@schema("vamotors")
}

model BusinessSequence {
  id    Int    @id @default(1)
  value BigInt @default(0)

  @@schema("vamotors")
}

model CommandReceipt {
  importWorkflow ImportBatch?
  id                    String              @id @db.Uuid
  environmentId         String              @db.Uuid
  actorKey              String
  commandName           String
  idempotencyKey        String              @db.Uuid
  inputHash             String
  committedAt           DateTime            @default(now())
  responseSchemaVersion Int                 @default(1)
  result                Json
  businessSequence      BigInt?             @unique
  audit                 AuditEntry[]
  versions              EntityReadVersion[]
  statuses              StatusEvent[]
  acquisitions          PurchaseRecord[]
  purchasePayments      PurchasePayment[]
  mileageReadings       MileageReading[]
  basisVersions         CycleBasisVersion[]
  costs                 VehicleCost[]
  costPayments          CostPayment[]
  repairs               RepairRecord[]      @relation("repairDispatch")
  repairReturns         RepairRecord[]      @relation("repairReturn")
  repairPayments        RepairPayment[]
  approvalRequests      ApprovalRequest[]   @relation("approvalRequestCommand")
  approvalReviews       ApprovalRequest[]   @relation("approvalReviewCommand")
  approvalApplications  ApprovalRequest[]      @relation("approvalAppliedCommand")
  disposals             Disposal[]
  disposalReceipts      DisposalReceipt[]
  sales                 SaleCase[]
  saleReceipts          SaleReceipt[]
  saleCompletions       SaleCompletion[]
  saleCorrections       SaleCorrection[]
  tradeInIntakes        TradeInConsideration[]

  @@unique([environmentId, actorKey, commandName, idempotencyKey])
  @@schema("vamotors")
}

model EntityReadVersion {
  importSource ImportSourceRow?
  id         String         @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String         @db.Uuid
  sequence   BigInt
  revision   Int
  payload    Json
  tombstone  Boolean        @default(false)
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, sequence])
  @@index([entityType, entityId, sequence(sort: Desc)])
  @@index([sequence])
  @@schema("vamotors")
}

model AuditEntry {
  id          String         @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String         @db.Uuid
  commandId   String         @db.Uuid
  command     CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  action      String
  actorKind   String
  userId      String?        @db.Uuid
  systemScope String?
  initiatedBy String?        @db.Uuid
  approverId  String?        @db.Uuid
  reason      String?
  recordedAt  DateTime       @default(now())
  fieldDiff   Json

  @@index([entityType, entityId, recordedAt, id])
  @@index([userId, recordedAt, id])
  @@index([commandId])
  @@schema("vamotors")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  eventKey        String
  kind            String
  targetType      String
  targetId        String    @db.Uuid
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  revision        Int       @default(1)

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, readAt, createdAt, id])
  @@schema("vamotors")
}

model Customer {
  id                 String           @id @default(uuid()) @db.Uuid
  fullName           String
  callingName        String
  nicOrPassport      String
  normalizedIdentity String           @unique
  address            String
  phone              String
  email              String?
  drivingLicence     String?
  notes              String?
  active             Boolean          @default(true)
  revision           Int              @default(1)
  createdBy          String           @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  purchases          PurchaseRecord[]
  sales              SaleCase[]
  tradeIns           TradeInConsideration[]

  @@index([phone])
  @@schema("vamotors")
}

model SettingsVersion {
  id          String           @id @default(uuid()) @db.Uuid
  version     Int              @unique
  effectiveAt DateTime         @default(now())
  values      Json
  current     Settings?
  purchases   PurchaseRecord[]

  @@schema("vamotors")
}

model Settings {
  id               String          @id @default(uuid()) @db.Uuid
  singleton        Int             @unique @default(1)
  revision         Int             @default(1)
  currentVersionId String          @unique @db.Uuid
  currentVersion   SettingsVersion @relation(fields: [currentVersionId], references: [id], onDelete: Restrict)

  @@schema("vamotors")
}

model FinanceCompany {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  active              Boolean                @default(true)
  revision            Int                    @default(1)
  createdBy           String                 @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  currentPolicyId     String                 @unique @db.Uuid
  currentPolicy       FinancePolicyVersion   @relation("currentPolicy", fields: [currentPolicyId, id], references: [id, companyId], onDelete: Restrict)
  policies            FinancePolicyVersion[] @relation("policies")
  contacts            FinanceContact[]
  rateSheets          RateSheetVersion[]
  quotes              Quote[]
  settlementPurchases LeasePurchaseDetail[]

  @@unique([currentPolicyId, id])
  @@schema("vamotors")
}

model RateSheetVersion {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  company      FinanceCompany  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  version      Int
  revision     Int             @default(1)
  make         String
  model        String
  year         Int
  maximum      BigInt
  validFrom    DateTime        @db.Date
  validThrough DateTime        @db.Date
  publishedAt  DateTime        @default(now())
  createdBy    String          @db.Uuid
  commandId    String          @unique @db.Uuid
  cards        RateCardEntry[]
  quotes       Quote[]

  @@unique([companyId, make, model, year, version])
  @@index([companyId, make, model, year, validFrom])
  @@schema("vamotors")
}

model RateCardEntry {
  id             String           @id @default(uuid()) @db.Uuid
  sheetVersionId String           @db.Uuid
  sheet          RateSheetVersion @relation(fields: [sheetVersionId], references: [id], onDelete: Restrict)
  principal      BigInt
  months         Int
  installment    BigInt
  quotes         Quote[]

  @@unique([sheetVersionId, principal, months])
  @@unique([id, sheetVersionId])
  @@schema("vamotors")
}

model Quote {
  id                 String           @id @default(uuid()) @db.Uuid
  revision           Int              @default(1)
  sheetId            String           @db.Uuid
  sheet              RateSheetVersion @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  cardId             String           @db.Uuid
  card               RateCardEntry    @relation(fields: [cardId, sheetId], references: [id, sheetVersionId], onDelete: Restrict)
  companyId          String           @db.Uuid
  company            FinanceCompany   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle            Json
  principal          BigInt
  months             Int
  installment        BigInt
  maximum            BigInt
  charges            Json
  policyVersionId    String           @db.Uuid
  policySnapshot     Json
  companySnapshot    Json
  settingsVersionId  String           @db.Uuid
  settingsSnapshot   Json
  commissionExpected BigInt
  createdBy          String           @db.Uuid
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  commandId          String           @unique @db.Uuid

  @@index([createdBy, createdAt, id])
  @@schema("vamotors")
}

model FinancePolicyVersion {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  company     FinanceCompany  @relation("policies", fields: [companyId], references: [id], onDelete: Restrict)
  version     Int
  effectiveAt DateTime        @default(now())
  values      Json
  currentFor  FinanceCompany? @relation("currentPolicy")

  @@unique([id, companyId])
  @@unique([companyId, version])
  @@schema("vamotors")
}

model FinanceContact {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  company   FinanceCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  phone     String
  email     String?
  role      String
  isPrimary Boolean        @default(false)
  active    Boolean        @default(true)

  @@schema("vamotors")
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  category       String
  nicOrRegNumber String?
  address        String?
  phone          String?
  hotline        String?
  notes          String?
  recurring      Boolean           @default(false)
  active         Boolean           @default(true)
  revision       Int               @default(1)
  createdBy      String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contacts       SupplierContact[]
  purchases      PurchaseRecord[]

  @@schema("vamotors")
}

model SupplierContact {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  phone      String
  email      String?
  role       String
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)

  @@schema("vamotors")
}

model RepairVendor {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  category       String
  nicOrRegNumber String?
  address        String?
  phone          String?
  hotline        String?
  notes          String?
  recurring      Boolean         @default(false)
  specialisation String?
  active         Boolean         @default(true)
  revision       Int             @default(1)
  createdBy      String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contacts       VendorContact[]
  repairs        RepairRecord[]

  @@schema("vamotors")
}

model VendorContact {
  id        String       @id @default(uuid()) @db.Uuid
  vendorId  String       @db.Uuid
  vendor    RepairVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  name      String
  phone     String
  email     String?
  role      String
  isPrimary Boolean      @default(false)
  active    Boolean      @default(true)

  @@schema("vamotors")
}

enum VehicleStatus {
  PURCHASED
  IN_STOCK
  IN_REPAIR
  ADVANCE_PLACED
  ADVANCE_EXPIRED
  FINANCE_PENDING
  DO_RECEIVED
  DELIVERED
  SOLD
  WRITTEN_OFF

  @@schema("vamotors")
}

model Vehicle {
  id                String           @id @default(uuid()) @db.Uuid
  engineNumber      String
  chassisNumber     String
  normalizedEngine  String
  normalizedChassis String
  make              String
  model             String
  year              Int
  colour            String
  fuelType          String
  transmission      String
  vin               String?
  crNumber          String?
  notes             String?
  revision          Int              @default(1)
  createdBy         String           @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  activePurchaseId  String?          @unique @db.Uuid
  purchases         PurchaseRecord[] @relation("cycles")
  activePurchase      PurchaseRecord?        @relation("activeCycle", fields: [activePurchaseId, id], references: [id, vehicleId], onDelete: Restrict)
  mileage             MileageReading[]
  tradeInAcquisitions TradeInConsideration[]

  @@unique([normalizedEngine, normalizedChassis])
  @@unique([activePurchaseId, id])
  @@schema("vamotors")
}

model PurchaseRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  vehicleId            String               @db.Uuid
  vehicle              Vehicle              @relation("cycles", fields: [vehicleId], references: [id], onDelete: Restrict)
  activeFor            Vehicle?             @relation("activeCycle")
  cycleNumber          Int
  purchaseType         String
  acquisitionKind      String
  supplierId           String?              @db.Uuid
  supplier             Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sellerCustomerId      String?                @db.Uuid
  seller                Customer?              @relation(fields: [sellerCustomerId], references: [id], onDelete: Restrict)
  tradeInSourceSaleId   String?                @unique @db.Uuid
  tradeInSource         TradeInConsideration?  @relation("tradeInSource", fields: [tradeInSourceSaleId, sellerCustomerId], references: [saleCaseId, customerId], onDelete: Restrict)
  purchaseDate          DateTime               @db.Date
  purchasePrice        BigInt
  notes                String?
  listedPrice          BigInt?
  status               VehicleStatus        @default(PURCHASED)
  available            Boolean              @default(false)
  holdReason           String?
  receivedDate         DateTime?            @db.Date
  closedAt             DateTime?
  revision             Int                  @default(1)
  createdBy            String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  statuses             StatusEvent[]
  acquisitionCommandId String?              @unique @db.Uuid
  acquisitionCommand   CommandReceipt?      @relation(fields: [acquisitionCommandId], references: [id], onDelete: Restrict)
  settingsVersionId    String?              @db.Uuid
  settingsVersion      SettingsVersion?     @relation(fields: [settingsVersionId], references: [id], onDelete: Restrict)
  payments             PurchasePayment[]
  mileage              MileageReading[]
  basisVersions        CycleBasisVersion[]
  costs                VehicleCost[]
  costPayments         CostPayment[]
  repairs              RepairRecord[]
  repairPayments       RepairPayment[]
  approvalRequests      ApprovalRequest[]
  disposal              Disposal?
  settlement            LeasePurchaseDetail?
  sales                 SaleCase[]
  saleReceipts          SaleReceipt[]
  saleCompletion        SaleCompletion?
  saleCorrections       SaleCorrection[]
  tradeInConsiderations TradeInConsideration[] @relation("saleCycleTradeIns")
  tradeInIntake         TradeInConsideration?  @relation("tradeInIntake")

  @@unique([id, vehicleId])
  @@unique([vehicleId, cycleNumber])
  @@unique([tradeInSourceSaleId, sellerCustomerId])
  @@index([status, available, purchaseDate, id])
  @@schema("vamotors")
}

// Mutable current terms only; root revisions and immutable read versions own history.
model LeasePurchaseDetail {
  id                      String          @id @default(uuid()) @db.Uuid
  purchaseRecordId        String          @unique @db.Uuid
  purchaseRecord          PurchaseRecord  @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  institutionType         String
  companyId               String?         @db.Uuid
  company                 FinanceCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  institutionNameSnapshot String
  reference               String
  amount                  BigInt
  cashToSeller            BigInt

  @@schema("vamotors")
}

model StatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  cycleId    String         @db.Uuid
  cycle      PurchaseRecord @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  from       VehicleStatus?
  to         VehicleStatus
  action     String
  commandId  String         @db.Uuid
  command    CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  userId     String         @db.Uuid
  occurredAt DateTime
  recordedAt DateTime       @default(now())

  @@index([cycleId, recordedAt, id])
  @@schema("vamotors")
}

model PurchasePayment {
  id           String           @id @default(uuid()) @db.Uuid
  cycleId      String           @db.Uuid
  cycle        PurchaseRecord   @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime         @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  reversalOf   String?          @unique @db.Uuid
  original     PurchasePayment? @relation("purchaseReversal", fields: [reversalOf, cycleId], references: [id, cycleId], onDelete: Restrict)
  reversal     PurchasePayment? @relation("purchaseReversal")
  reason       String?
  commandId    String           @db.Uuid
  command      CommandReceipt   @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime         @default(now())

  @@unique([id, cycleId])
  @@unique([commandId, lineKey])
  @@unique([reversalOf, cycleId])
  @@index([cycleId, occurredDate, id])
  @@schema("vamotors")
}

model ApprovalRequest {
  id                   String          @id @db.Uuid
  cycleId              String          @db.Uuid
  cycle                PurchaseRecord  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  kind                 String
  schemaVersion        Int             @default(1)
  proposal             Json
  expected             Json
  snapshot             Json
  payloadHash          String
  reason               String
  requestedBy          String          @db.Uuid
  requester            User            @relation("approvalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  requestedAt          DateTime        @default(now())
  state                String          @default("PENDING")
  revision             Int             @default(1)
  reviewedBy           String?         @db.Uuid
  reviewer             User?           @relation("approvalReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  reviewNote           String?
  reviewerName         String?
  requiredRecipientIds Json
  requestCommandId     String          @unique @db.Uuid
  requestCommand       CommandReceipt  @relation("approvalRequestCommand", fields: [requestCommandId], references: [id], onDelete: Restrict)
  reviewCommandId      String?         @unique @db.Uuid
  reviewCommand        CommandReceipt? @relation("approvalReviewCommand", fields: [reviewCommandId], references: [id], onDelete: Restrict)
  appliedCommandId     String?          @unique @db.Uuid
  appliedCommand       CommandReceipt?  @relation("approvalAppliedCommand", fields: [appliedCommandId], references: [id], onDelete: Restrict)
  saleCaseId           String?          @db.Uuid
  saleCase             SaleCase?        @relation("approvalSaleCase", fields: [saleCaseId, cycleId], references: [id, purchaseRecordId], onDelete: Restrict)
  disposal             Disposal?
  discountSaleCase     SaleCase?        @relation("saleApproval")
  saleCompletions      SaleCompletion[]
  saleCorrections      SaleCorrection[]

  @@unique([id, cycleId])
  @@index([state, requestedAt, id])
  @@index([requestedBy, requestedAt, id])
  @@schema("vamotors")
}

model Disposal {
  id             String            @id @db.Uuid
  cycleId        String            @unique @db.Uuid
  cycle          PurchaseRecord    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  approvalId     String            @unique @db.Uuid
  approval       ApprovalRequest   @relation(fields: [approvalId, cycleId], references: [id, cycleId], onDelete: Restrict)
  approvalKind   String            @default("CURRENT")
  occurredDate   DateTime          @db.Date
  reason         String
  method         String
  proceeds       BigInt
  basisVersionId String            @db.Uuid
  basis          CycleBasisVersion @relation(fields: [basisVersionId, cycleId], references: [id, cycleId], onDelete: Restrict)
  netLoss        BigInt
  createdBy      String            @db.Uuid
  creator        User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  commandId      String            @unique @db.Uuid
  command        CommandReceipt    @relation(fields: [commandId], references: [id], onDelete: Restrict)
  recordedAt     DateTime          @default(now())
  payments       DisposalReceipt[]

  @@unique([id, cycleId])
  @@unique([approvalId, cycleId])
  @@schema("vamotors")
}

model DisposalReceipt {
  id           String         @id @db.Uuid
  disposalId   String         @unique @db.Uuid
  cycleId      String         @db.Uuid
  disposal     Disposal       @relation(fields: [disposalId, cycleId], references: [id, cycleId], onDelete: Restrict)
  amount       BigInt
  direction    String
  category     String
  occurredDate DateTime       @db.Date
  method       String
  currency     String
  scale        Int
  reference    String?
  commandId    String         @db.Uuid
  command      CommandReceipt @relation(fields: [commandId], references: [id], onDelete: Restrict)
  lineKey      String
  recordedAt   DateTime       @default(now())

  @@unique([commandId, lineKey])
  @@index([cycleId, occurredDate, id])
  @@schema("vamotors")
}

model SaleCase {
  id               String                @id @default(uuid()) @db.Uuid
  purchaseRecordId String                @db.Uuid
  purchaseRecord   PurchaseRecord        @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  customerId       String                @db.Uuid
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind             String
  agreedPrice      BigInt
  listedSnapshot   BigInt?
  reference        String?
  notes            String?
  state            String
  revision         Int                   @default(1)
  openedAt         DateTime
  createdBy        String                @db.Uuid
  commandId        String                @unique @db.Uuid
