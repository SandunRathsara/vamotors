  recordedAt DateTime     @default(now())
  errorCode  String?
  commandId  String       @db.Uuid

  @@unique([uploadId, revision])
  @@schema("vamotors")
}

// ── T11b/T12 external brokerage ─────────────────────────────────────────────

// Immutable path, state machine and financial policy snapshots. No owned
// Vehicle/PurchaseRecord is ever created for a brokerage deal.
model BrokerageDeal {
  id                       String                @id @default(uuid()) @db.Uuid
  customerId               String                @db.Uuid
  companyId                String                @db.Uuid
  externalVehicle          Json
  path                     String
  state                    String                @default("INTAKE")
  originalQuoteId          String                @db.Uuid
  currentQuoteSelectionId  String?               @unique @db.Uuid
  currentQuoteSelection    DealQuoteSelection?   @relation("currentSelection", fields: [currentQuoteSelectionId], references: [id], onDelete: Restrict)
  selections               DealQuoteSelection[] @relation("dealSelections")
  quoteStatus              String                @default("SUPPORTED")
  requestedLoan            BigInt
  approvedLoan             BigInt
  processingFee            BigInt
  processingFeeOverridden  Boolean               @default(false)
  effectivePolicySnapshot  Json
  chargesSnapshot          Json
  fileReference            String?
  informedContactId        String?               @db.Uuid
  informedAt               DateTime?
  rejectionReason          String?
  rejectedAt               DateTime?
  completedAt              DateTime?
  commandId                String                @unique @db.Uuid
  revision                 Int                   @default(1)
  createdBy                String                @db.Uuid
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  guarantors               GuarantorParticipation[]
  eligibility              EligibilityCheck[]
  photos                   InspectionPhoto[]
  checklist                ChecklistItem[]
  verification             VerificationEvent[]
  events                   DealEvent[]
  issues                   ProcessingIssue[]
  facility                 CashFacility?
  feeReceipts              BrokerageFeeReceipt[]
  entitlement              CommissionEntitlement?
  dispatchItem             DispatchItem?
  uploads                  UploadIntent[]
  attachments              Attachment[]

  @@index([companyId, state, id])
  @@index([customerId, id])
  @@schema("vamotors")
}

